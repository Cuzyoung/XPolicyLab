{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xpolicylab.github.io/schemas/lingbot-vla2-yam-bundle-v1.json",
  "title": "XPolicyLab LingBot-VLA2 YAM post-training bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "model", "artifacts", "control", "embodiment"],
  "properties": {
    "schema_version": {
      "const": "xpolicylab.lingbot_vla2_yam_bundle.v1"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "official_source_revision"],
      "properties": {
        "family": {"const": "lingbot-vla-v2"},
        "official_source_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["training_config", "checkpoint", "norm_stats", "robot_config"],
      "properties": {
        "training_config": {"type": "string", "minLength": 1, "pattern": "^(?!/).*"},
        "checkpoint": {"type": "string", "minLength": 1, "pattern": "^(?!/).*"},
        "norm_stats": {"type": "string", "minLength": 1, "pattern": "^(?!/).*"},
        "robot_config": {"type": "string", "minLength": 1, "pattern": "^(?!/).*"}
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["native_hz", "action_horizon", "action_space"],
      "properties": {
        "native_hz": {"type": "number", "exclusiveMinimum": 0},
        "action_horizon": {"type": "integer", "minimum": 1},
        "action_space": {"const": "absolute_joint_position"}
      }
    },
    "embodiment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "arm_dofs", "gripper_dofs", "cameras"],
      "properties": {
        "name": {"const": "yam_dual"},
        "arm_dofs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [{"const": 6}, {"const": 6}],
          "items": false
        },
        "gripper_dofs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [{"const": 1}, {"const": 1}],
          "items": false
        },
        "cameras": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {"const": "camera_top"},
            {"const": "camera_wrist_left"},
            {"const": "camera_wrist_right"}
          ],
          "items": false
        }
      }
    }
  }
}
